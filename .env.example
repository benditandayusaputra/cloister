# Salin ke .env lalu isi. Nilai dibiarkan kosong dengan sengaja:
# di produksi aplikasi menolak start kalau rahasia di bawah belum diisi.

DATABASE_URL="postgres://user:pass@host/cloister?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://user:pass@host/cloister?sslmode=require"

# Wajib. Buat dengan: openssl rand -base64 32
# SERVER_AUTH_PEPPER hilang = semua akun tidak bisa masuk lagi. Cadangkan terpisah dari database.
SERVER_AUTH_PEPPER=""
SALT_HMAC_SECRET=""
IP_HMAC_SECRET=""
JWT_SECRET=""

# Opsional
RESEND_API_KEY=""
MAIL_FROM="Cloister <no-reply@contoh.id>"
BLOB_READ_WRITE_TOKEN=""
BLOB_LOCAL_DIR=".blobstore"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
CRON_SECRET=""
PUBLIC_READ_ORIGIN=""
# Akun yang barisnya dipakai sebagai contoh di /bukti untuk pengunjung tanpa login
DEMO_EMAIL="benditandayusaputra@gmail.com"
# Setel "1" hanya di dev untuk melewati kode gambar saat menjalankan tes otomatis
CAPTCHA_DISABLED=""

# Pengingat harian. Buat dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:halo@contoh.id"

# Passkey di balik reverse proxy: isi dengan domain publik
WEBAUTHN_RP_ID=""
WEBAUTHN_ORIGIN=""
