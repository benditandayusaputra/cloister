{
	"name": "cloister",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.14.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"lint": "svelte-check --tsconfig ./tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"seed": "node scripts/seed-sample.mjs",
		"seed:publik": "node scripts/seed-publik.mjs",
		"manifest": "node scripts/build-manifest.mjs > build-manifest.json"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/libsodium-wrappers-sumo": "^0.8.2",
		"@types/qrcode": "^1.5.6",
		"@types/web-push": "^3.6.4",
		"@vitest/browser": "^4.1.10",
		"drizzle-kit": "^0.31.10",
		"jszip": "^3.10.1",
		"playwright": "^1.62.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@simplewebauthn/browser": "^13.3.0",
		"@simplewebauthn/server": "^13.3.2",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@vercel/blob": "^2.6.1",
		"dexie": "^4.4.4",
		"drizzle-orm": "^0.45.2",
		"isomorphic-dompurify": "^3.20.0",
		"jose": "^6.2.5",
		"libsodium-wrappers-sumo": "^0.8.4",
		"marked": "^18.0.7",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"uuidv7": "^1.2.1",
		"valibot": "^1.4.2",
		"web-push": "^3.6.7"
	},
	"description": "Jurnal harian PWA dengan enkripsi di perangkat. Server menyimpan replika terenkripsi, bukan isi yang dapat dibaca.",
	"license": "AGPL-3.0-or-later"
}
