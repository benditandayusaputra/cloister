# Konfigurasi CI ikut masuk repositori. Sebagian mesin punya gitignore global
# yang mengecualikan .github/; baris ini mengembalikannya.
!.github/

node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Tes
/test-results
/playwright-report
/blob-report
/.playwright

# Penyimpanan lampiran lokal untuk self-host
/.blobstore

# File kredensial akun contoh
AKUN-CONTOH.txt
build-manifest.json

# Proyek ini memakai pnpm (lihat packageManager di package.json)
bun.lock
bun.lockb
package-lock.json
yarn.lock
